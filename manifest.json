{
  "manifest_version": 3,
  "name": "Viking Power Search",
  "version": "1.0.0",
  "description": "Save Viking Cruises Australia itineraries and find the earliest lowest-priced PS3 (Penthouse Junior Suite) departure date.",
  "key": "",
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Viking Power Search",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.vikingcruises.com.au/*"
  ]
}
